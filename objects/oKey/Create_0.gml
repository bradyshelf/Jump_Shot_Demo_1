// Create Event (coin)
ystart = y;          // base Y to hover around
t = 0;               // time accumulator

// tweak these to taste
hover_height = 4;    // vertical bob amount (pixels)
hover_speed = 1.0;   // how many hover cycles per second (1.0 = once per second)
rot_speed   = 0.5;   // how many flip cycles per second (0.5 = one flip every 2 seconds)
